<div class="col-md-3">
    <div class="profile-sidebar">
        <h5>My Profile</h5>
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ViewProfile" ? "active" : "")"
               asp-controller="Account" asp-action="ViewProfile">My Profile</a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "VerifyByPassword" ? "active" : "")"
               asp-controller="Account" asp-action="VerifyByPassword">Change Password</a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Purchase" ? "active" : "")"
               asp-controller="Order" asp-action="Purchase">My Purchase</a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Address" ? "active" : "")"
               asp-controller="Account" asp-action="Address">Address</a>
        </nav>
    </div>
</div>
