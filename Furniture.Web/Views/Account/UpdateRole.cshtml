@model Furniture.Core.AccountDto;

@{
    ViewData["Title"] = "Cập nhật quyền tài khoản";
}

<h2 class="text-center">Cập nhật Vai Trò Tài Khoản</h2>
<div class="container mt-4">
    <form asp-action="UpdateRole" method="post" class="card p-4 shadow">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Tên tài khoản</label>
            <input type="text" class="form-control" asp-for="Name" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Quyền</label>
            <select class="form-select" asp-for="RoleName">
                <option value="Admin">Admin</option>
                <option value="Customer">Customer</option>
                <option value="Employee">Employee</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-controller="Admin" asp-action="Index class="btn btn-secondary">Hủy</a>
    </form>
</div>
