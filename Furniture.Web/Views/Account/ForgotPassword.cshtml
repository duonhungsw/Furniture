@{
	Layout = null;
}


	<!doctype html>
<html lang="en">
<head>
	<title>Furniture</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.9/css/unicons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.0/css/bootstrap.min.css">
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<link rel="stylesheet" href="~/css/login.css">

</head>
<body>
	<div class="section">
		<div class="container">
			<div class="row full-height justify-content-center">
				<div class="col-12 text-center align-self-center py-5">
					<div class="section pb-5 pt-5 pt-sm-2 text-center">
						<div class="card-3d-wrap mx-auto">
							<div class="card-3d-wrapper">
								<div class="card-front">
									<div class="center-wrap">
										<div class="section text-center">
											<h4 class="mb-4 pb-3">Change Password</h4>
											@{
												var successMessage = TempData["Success"] as string;
												var errorMessage = TempData["Error"] as string;
											}

											@if (!string.IsNullOrEmpty(successMessage))
											{
												<div class="alert alert-success">
													<h4>@successMessage</h4>
												</div>
											}
											else if (!string.IsNullOrEmpty(errorMessage))
											{
												<div class="alert alert-danger">
													@errorMessage
												</div>
											}

											<form id="forgotPasswordForm" asp-action="ForgotPassword" asp-controller="Account" method="post">
												<div class="form-group">
													<input type="email" class="form-style" name="Email" id="Email"
														   placeholder="Email" oninput="validateForm()" required autocomplete="email">
													<div id="emailError" class="text-danger"></div>
												</div>
												<button type="submit" class="btn mt-4" id="signInBtn">Next</button>
											</form>

										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script src="~/js/validation.js"></script>
</body>
</html>