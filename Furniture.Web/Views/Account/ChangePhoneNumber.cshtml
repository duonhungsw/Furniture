<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Phone Number</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f5f5f5;
        }

        .profile-sidebar {
            background: white;
            padding: 20px;
            border-radius: 10px;
        }
    
        .profile-container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            color: #333;
            transition: background 0.3s;
        }

            .nav-link.active, .nav-link:hover {
                font-weight: bold;
                color: #ee4d2d;
                background-color: #ffeae5;
                border-radius: 5px;
            }
        .step-indicator {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .step {
            text-align: center;
            flex: 1;
        }

            .step span {
                display: inline-block;
                width: 30px;
                height: 30px;
                line-height: 30px;
                border-radius: 50%;
                background: #28a745;
                color: white;
                font-weight: bold;
            }

            .step.active span {
                background: #ee4d2d;
            }

        .form-control {
            border-radius: 5px;
        }

        .btn-primary {
            background-color: #ee4d2d;
            border: none;
        }
    </style>
</head>
<body>
    @{
        ViewData["Title"] = "Change Phone Number";
    }
    <div class="container mt-4">
        <div class="row">
            @await Html.PartialAsync("_Sidebar")

            <!-- Nội dung chính bên phải -->
            <div class="col-md-9">
                <div class="profile-container">
                    <h4 class="text-center">Change Phone Number</h4>
                    <p class="text-center">For your safety, please follow the steps below to change your phone number</p>

                    <!-- Hiển thị thông báo -->
                    <div id="messageContainer">
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-@TempData["MessageType"]">
                                @TempData["Message"]
                            </div>
                        }
                    </div>

                    <!-- Bước tiến trình -->
                    <div class="step-indicator">
                        <div class="step"><span>1</span><br>Verification</div>
                        <hr style="flex: 1; border: 1px solid #28a745; margin: 0 10px;">
                        <div class="step"><span>2</span><br>Authentication</div>
                        <hr style="flex: 1; border: 1px solid #28a745; margin: 0 10px;">
                        <div class="step @(TempData["MessageType"] == "success" ? "" : "active")">
                            <span>3</span><br>Update Phone Number
                        </div>
                        <hr style="flex: 1; border: 1px solid @(TempData["MessageType"] == "success" ? "#28a745" : "#ddd"); margin: 0 10px;">
                        <div class="step">
                            <span style="background:@(TempData["MessageType"] == "success" ? "#28a745" : "#ddd");">✔</span><br>Complete
                        </div>
                    </div>

                    <!-- Form thay đổi số điện thoại -->
                    <form asp-controller="Account" asp-action="ChangePhoneNumber" method="post">
                        <div class="mb-3">
                            <label class="form-label">New Phone Number</label>
                            <input type="text" class="form-control" id="phoneNumber" name="Phone" placeholder="Enter your phone number" required>
                        </div>
                        <div class="mb-3 d-flex">
                            <input type="text" class="form-control" name="session" placeholder="Verification Code" required>
                            <button type="button" id="sendCodeBtn" class="btn btn-outline-primary ms-2">Send Code</button>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var messageContainer = document.getElementById("messageContainer");
            if (messageContainer) {
                setTimeout(function () {
                    messageContainer.innerHTML = "";
                }, 10000); // Xóa thông báo sau 5 giây
            }
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#sendCodeBtn").click(function () {
                var phone = $("#phoneNumber").val(); // Lấy số điện thoại
                if (!phone) {
                    alert("Please enter your phone number.");
                    return;
                }

                $.ajax({
                    url: "/Notification/SendSms",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ to: phone }), // Gửi số điện thoại
                    success: function (response) {
                        $("#messageContainer").html('<div class="alert alert-success">✅ SMS sent successfully. Check your phone!</div>');
                        startCountdown();
                    },
                    error: function () {
                        $("#messageContainer").html('<div class="alert alert-danger">❌ Failed to send SMS. Please try again!</div>');
                    }
                });
            });

            function startCountdown() {
                $("#sendCodeBtn").prop("disabled", true);
                let counter = 60;
                $("#sendCodeBtn").text(`Wait ${counter}s`);
                const interval = setInterval(() => {
                    counter--;
                    $("#sendCodeBtn").text(`Wait ${counter}s`);
                    if (counter === 0) {
                        clearInterval(interval);
                        $("#sendCodeBtn").prop("disabled", false).text("Send Code");
                    }
                }, 1000);
            }
        });
    </script>
    <script src="~/js/form-validation.js"></script>
</body>
</html>
