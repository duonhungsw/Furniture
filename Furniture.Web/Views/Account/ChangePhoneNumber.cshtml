<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Phone Number</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f5f5f5;
        }

        .profile-sidebar {
            background: white;
            padding: 20px;
            border-radius: 10px;
        }
    
        .profile-container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            color: #333;
            transition: background 0.3s;
        }

            .nav-link.active, .nav-link:hover {
                font-weight: bold;
                color: #ee4d2d;
                background-color: #ffeae5;
                border-radius: 5px;
            }
        .step-indicator {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .step {
            text-align: center;
            flex: 1;
        }

            .step span {
                display: inline-block;
                width: 30px;
                height: 30px;
                line-height: 30px;
                border-radius: 50%;
                background: #28a745;
                color: white;
                font-weight: bold;
            }

            .step.active span {
                background: #ee4d2d;
            }

        .form-control {
            border-radius: 5px;
        }

        .btn-primary {
            background-color: #ee4d2d;
            border: none;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="row">
             @await Html.PartialAsync("_Sidebar")

            <!-- Nội dung chính bên phải (chiếm 9 cột) -->
            <div class="col-md-9">
                <div class="profile-container">
                    <h4 class="text-center">Change Phone Number</h4>
                    <p class="text-center">For your safety, please follow the steps below to change your phone number</p>

                    <div class="step-indicator">
                        <div class="step"><span>1</span><br>Verification</div>
                        <hr style="flex: 1; border: 1px solid #28a745; margin: 0 10px;">
                        <div class="step"><span>2</span><br>Authentication</div>
                        <hr style="flex: 1; border: 1px solid #28a745; margin: 0 10px;">
                        <div class="step active"><span>3</span><br>Update Phone Number</div>
                        <hr style="flex: 1; border: 1px solid #ddd; margin: 0 10px;">
                        <div class="step"><span style="background:#ddd;">✔</span><br>Complete</div>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label class="form-label">New Phone Number</label>
                            <input type="text" class="form-control" name="phone" placeholder="Enter your phone number" required>
                        </div>
                        <div class="mb-3 d-flex">
                            <input type="text" class="form-control" placeholder="Verification Code" required>
                            <button type="button" class="btn btn-outline-primary ms-2">Send Code</button>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
