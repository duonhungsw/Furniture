@model AccountDto
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f5f5f5;
        }

        .profile-sidebar {
            background: white;
            padding: 20px;
            border-radius: 10px;
        }

        .profile-content {
            background: white;
            padding: 20px;
            border-radius: 10px;
            position: relative;
        }

        .nav-link {
            color: #333;
            transition: background 0.3s;
        }

            .nav-link.active, .nav-link:hover {
                font-weight: bold;
                color: #ee4d2d;
                background-color: #ffeae5;
                border-radius: 5px;
            }

        .avatar-container {
            text-align: center;
        }

        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ddd;
        }

        .avatar-upload {
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="row">

            @await Html.PartialAsync("_Sidebar")

            <!-- Nội dung chính -->
            <div class="col-md-9">
                <div class="profile-content">
                    <h4>My Profile</h4>
                    <form asp-action="UpdateProfile" enctype="multipart/form-data">
                    <div class="row">
                                <div class="col-md-8">
                                    <div class="mb-3">
                                        <input type="text" class="form-control" name="Id" value="@Model.Id" hidden>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Username</label>
                                        <input type="text" class="form-control" name="Name" value="@Model.Name">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" value="@Model.Email" disabled>
                                    </div>
                                    <div class="mb-3 d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <label class="form-label">Phone Number</label>
                                            <input type="text" class="form-control" id="phoneInput" name="Phone" value="@Model.Phone" readonly>

                                        </div>
                                    <a asp-controller="Account" asp-action="ChangePhoneNumber" class="btn btn-outline-primary ms-2">Change</a>
                                </div>
                                    <div class="mb-3">
                                        <label class="form-label">Day of Birthday</label>
                                        <input type="text" class="form-control" name="BirthDay" value="@Model.BirthDay">
                                    </div>
                                    <div class="avatar-container">
                                        <img id="avatarPreview" src="@Model.Avatar" alt="Avatar" class="avatar">
                                        <div class="avatar-upload">
                                        <input type="file" class="form-control" id="avatarInput" name="Avatar" accept="image/*">
                                        <input type="text" name="Avatar" value="@Model.Avatar" hidden >
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-danger">Save</button>
                                </div>

@*                         <div class="col-md-4 text-center">
                            
                        </div> *@
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('avatarInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>
