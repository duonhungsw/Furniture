@using System.Globalization

@model ProductDto

<div class="hero">
    <div class="container">
        <div class="row justify-content-between">
            <div class="col-lg-5">
                <div class="intro-excerpt">
                    <h1>Product detail</h1>
                </div>
            </div>
            <div class="col-lg-7">
            </div>
        </div>
    </div>
</div>
<!-- End Hero Section -->
<div class="product-detail-container">
    <div class="product-image">
        <div id="carouselProductImage" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @foreach (var item in @Model.PictureUrl!.Split(',').Select((value, index) => new { value, index }))
                {
                    <div class="carousel-item @(item.index == 0 ? "active" : "")">
                        <img src="@item.value" class="d-block w-100" alt="Product Image">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselProductImage" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselProductImage" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        @* <img src="@Model.PictureUrl.Split(',')[0]" alt="Product Image"> *@
    </div>
    <div class="product-info">
        <h1 class="product-title">@Model.Name</h1>
        <p class="product-price">@Model.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN")) </p>

        <div class="product-options">
            <label for="quantity">Quantity:</label>
            <input type="number" id="quantity" name="quantity" min="1" max="@Model.QuantityInStock" value="1" @(Model.QuantityInStock == 0 ? "disabled" : "")>
            <i>In stock: @Model.QuantityInStock</i>
        </div>

        <button class="add-to-cart-btn" id="addToCartBtn" data-product-id="@Model.Id" @(Model.QuantityInStock == 0 ? "disabled" : "")>
            @(Model.QuantityInStock == 0 ? "Out of Stock" : "Add to Cart")
        </button>


    </div>


</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).on("click", "#addToCartBtn", function (e) {
        e.preventDefault();

        let productId = $(this).data("product-id");
        let quantity = parseInt($("#quantity").val()) || 1;
        let stock = parseInt($("i:contains('In stock')").text().replace("In stock: ", ""));

        if (quantity > stock) {
            alert(`⚠️ Only ${stock} items available in stock!`);
            $("#quantity").val(stock);  // Reset về giá trị tối đa hợp lệ
            return;
        }

        $.ajax({
            url: "/Cart/AddCartItem",
            type: "POST",
            contentType: "application/x-www-form-urlencoded",
            data: {
                ProductId: productId,
                Quantity: quantity
            },
            success: function (response) {
                if (response) {
                    alert("✅ Added to cart successfully!");
                    let newStock = stock - quantity;
                    $("i:contains('In stock')").text(`In stock: ${newStock}`);
                    if (newStock === 0) {
                        $("#quantity").val(0).prop("disabled", true);
                        $("#addToCartBtn").prop("disabled", true).text("Out of Stock");
                    }
                } else {
                    alert("⚠️ Failed to add to cart!");
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
                alert("⛔ An error occurred!");
            }
        });
    });



</script>
}