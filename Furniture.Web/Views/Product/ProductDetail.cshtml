<!-- End Hero Section -->
<div class="product-detail-container">
    <div class="product-image">
        <div id="carouselProductImage" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @foreach (var item in @Model.PictureUrl!.Split(',').Select((value, index) => new { value, index }))
                {
                    <div class="carousel-item @(item.index == 0 ? "active" : "")">
                        <img src="@item.value" class="d-block w-100" alt="Product Image">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselProductImage"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselProductImage"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        @* <img src="@Model.PictureUrl.Split(',')[0]" alt="Product Image"> *@
    </div>
    <div class="product-info">
        <div class="card shadow-sm p-4 border-0">
            <div class="card-body">
                <h2 class="card-title text-primary">@Model.Name</h2>
                <hr>
                <div class="mb-3">
                    <h5 class="text-muted">Price:</h5>
                    <p class="fs-4 fw-bold text-success">@Model.Price $</p>
                </div>
                <div>
                    <h5 class="text-muted">Description:</h5>
                    <p class="text-secondary">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="product-options mt-4 d-flex align-items-center">
            <label for="quantity" class="me-2 fw-bold">Quantity:</label>
            <input type="number" id="quantity" class="form-control w-25 me-2" name="quantity" min="1"
                max="@Model.QuantityInStock" value="1" @(Model.QuantityInStock == 0 ? "disabled" : "")>
            <span class="text-muted">In stock: @Model.QuantityInStock</span>
        </div>

        <button class="btn btn-success w-auto px-4 py-2 fw-bold rounded-pill" id="addToCartBtn"
            data-product-id="@Model.Id" @(Model.QuantityInStock == 0 ? "disabled" : "")>
            @(Model.QuantityInStock == 0 ? "Out of Stock" : "Add to Cart")
        </button>
    </div>



</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
           $(document).on("click", "#addToCartBtn", function (e) {
        e.preventDefault();

        let productId = $(this).data("product-id");
        let productName = $("#productName").text(); // Lấy tên sản phẩm
        let productPrice = $("#productPrice").text(); // Lấy giá sản phẩm
        let productImage = $("#productImage").attr("src"); // Lấy ảnh sản phẩm
        let quantity = parseInt($("#quantity").val()) || 1;
        let stock = parseInt($("i:contains('In stock')").text().replace("In stock: ", ""));

        if (quantity > stock) {
            alert(`⚠️ Only ${stock} items available in stock!`);
            $("#quantity").val(stock);
            return;
        }

        $.ajax({
            url: "/Cart/AddCartItem",
            type: "POST",
            contentType: "application/x-www-form-urlencoded",
            data: {
                ProductId: productId,
                Quantity: quantity
            },
            success: function (response) {
                if (response) {
                    showCartNotification(productImage, productName, productPrice);

                    // Cập nhật số lượng trên giỏ hàng
                    let badge = $(".badge.bg-danger");
                    let currentItems = parseInt(badge.text()) || 0;
                    let newItemsNumber = currentItems + quantity;

                    badge.text(newItemsNumber); // Cập nhật số lượng mới

                    // Cập nhật stock sau khi thêm vào giỏ hàng
                    let newStock = stock - quantity;
                    $("i:contains('In stock')").text(`In stock: ${newStock}`);
                    if (newStock === 0) {
                        $("#quantity").val(0).prop("disabled", true);
                        $("#addToCartBtn").prop("disabled", true).text("Out of Stock");
                    }
                } else {
                    alert("⚠️ Failed to add to cart!");
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
                alert("⛔ An error occurred!");
            }
        });
    });


    // Hiển thị thông báo sản phẩm đã thêm vào giỏ hàng
    function showCartNotification(image, name, price) {
        // Xóa thông báo cũ nếu có
        $("#cartNotification").remove();

        let notification = `
    <div id="cartNotification" style="
                position: fixed; right: 20px; top: 20px; background: white; padding: 15px;
                border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 300px;
                display: flex; align-items: center; gap: 10px; z-index: 1000; opacity: 0;
                transform: translateY(-10px); transition: opacity 0.3s ease, transform 0.3s ease;">
        <img src="${image}" alt="${name}" style="width: 50px; height: 50px; border-radius: 5px;">
        <div>
            <strong>Added to cart successfully!</strong><br>
            <span>${name}</span><br>
            <span style="color: red; font-weight: bold;">${price}</span>
        </div>
        <button id="closeNotification" style="
                    background: transparent; border: none; font-size: 16px; cursor: pointer;">
            ✖
        </button>
    </div>`;

        $("body").append(notification);

        // Hiển thị hiệu ứng mượt
        setTimeout(() => {
            $("#cartNotification").css({ opacity: 1, transform: "translateY(0)" });
        }, 10);

        // Xóa thông báo sau 3 giây
        setTimeout(() => {
            $("#cartNotification").fadeOut(500, function () { $(this).remove(); });
        }, 3000);

        // Cho phép đóng thông báo ngay lập tức
        $(document).on("click", "#closeNotification", function () {
            $("#cartNotification").remove();
        });
    }

</script>


