@model List<Furniture.Core.ProductDto>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h2 class="text-center mt-4">Danh sách sản phẩm</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-secondary" asp-controller="Admin" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Home Admin
    </a>
    <a class="btn btn-primary" asp-controller="Admin" asp-action="Create">
        <i class="fas fa-plus"></i> Thêm sản phẩm
    </a>
</div>

<table class="table table-hover shadow-sm rounded text-center">
    <thead class="bg-dark text-white">
        <!-- Đổi màu nền thành đen -->
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Ảnh</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td class="font-weight-bold">@product.Name</td>
                <td class="text-success">@product.Price.ToString("C")</td>
                <td>
                    @if (!string.IsNullOrEmpty(product.PictureUrl))
                    {
                        <img src="@product.PictureUrl.Split(',')[0]" class="rounded shadow" width="80" height="80" />
                    }
                    else
                    {
                        <span class="text-muted">Không có ảnh</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("Update", "Admin", new { id = product.Id })" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Cập nhật
                    </a>
                    <a href="@Url.Action("ConfirmDelete", "Admin", new { id = product.Id })" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash-alt"></i> Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
