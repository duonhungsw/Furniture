@model List<Furniture.Core.AccountDto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    @await Html.PartialAsync("_adminHeadComponent");
    <title>Manage Account</title>
</head>
<body class="sb-nav-fixed">
    <!-- Admin navbar -->
    @await Html.PartialAsync("_adminNavBarComponent");
    <div id="layoutSidenav">
        <!-- Admin Slidenav -->
        @await Html.PartialAsync("_adminSlideNavComponent");
        <div id="layoutSidenav_content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div id="success-alert" class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <main>
                <div class="container-fluid px-4">
                    <h1 class="mt-4">Manage Accounts</h1>
                    <ol class="breadcrumb mb-4">
                        <li class="breadcrumb-item active">All current accounts in system</li>
                    </ol>
                    <div class="card mb-4 shadow-lg">
                        <div class="card-header fw-bold bg-primary text-white">
                            <i class="bi bi-table me-2"></i> Admin Accounts Table
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="adminAccountTable" class="table table-hover align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Email</th>                                            
                                            <th>Role</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in Model)
                                        {
                                            <tr>
                                                <td>@account.Id</td>
                                                <td class="fw-bold">@account.Name</td>
                                                <td>@account.Email</td>                                                
                                                <td>@account.RoleName</td> 
                                                <td>
                                                    <a asp-action="UpdateRole" asp-route-id="@account.Id" class="btn btn-sm btn-warning">
                                                        <i class="bi bi-pencil-square"></i> Update
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <!-- Footer -->
            @await Html.PartialAsync("_adminFooter");
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="js/scripts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" crossorigin="anonymous"></script>
    <script src="js/datatables-simple-demo.js"></script>
    <
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $("#success-alert").fadeOut("slow");
            }, 3000);
        });
    </script>
</body>
</html>