@model List<CartItemDto>

<!DOCTYPE html>
<html lang="en">


<body>
	<div class="untree_co-section before-footer-section">
		<div class="container">
			<div class="row mb-5">
				<form class="col-md-12" method="post">
					<div class="site-blocks-table">
						<table class="table">
							<thead>
								<tr>
									<th></th>
									<th class="product-thumbnail">Image</th>
									<th class="product-name">Product</th>
									<th class="product-price">Price</th>
									<th class="product-quantity">Quantity</th>
									<th class="product-total">Total</th>
									<th class="product-remove">Remove</th>
								</tr>
							</thead>
							<tbody>
								@if (Model == null || !Model.Any())
								{
									<tr>
										<td colspan="7">
											<p>Không có sản phẩm trong giỏ hàng</p>
										</td>
									</tr>
								}
								else
								{
									@foreach (var items in @Model)
									{
										<tr id="cart-item-@items.Id">
											<td>
												<input type="checkbox" class="cart-item-checkbox" data-cartitem-id="@items.Id"
													@(items.Status ? "checked" : "") />
											</td>


											<td class="product-thumbnail">
												<img src="@items.UrlImage" alt="Image" class="img-fluid">
											</td>
											<td class="product-name">
												<h2 class="h5 text-black">@items.ProductName</h2>
											</td>
											<td class="price" data-price="@items.Price">@items.Price $</td>
											<td>
												<input type="number" name="Quantities" value="@items.Quantity" min="1" max="@items.QuantityInStock"
													class="form-control quantity" data-cartItem-id="@items.Id"
													style="width: 80px; display: inline-block;"
													onchange="updateCartItemQuantity('@items.Id')" />
											</td>

											<td><span id="productTotalPrice-@items.Id">@items.TotalMoney</span></td>




											<td><a href="#" data-cartItem-id="@items.Id"
													onclick="deleteCartItem('@items.Id', event)"
													class="btn btn-black btn-sm">X</a></td>



										</tr>
									}
								}
							</tbody>

						</table>
					</div>
				</form>
			</div>

			<div class="row">
				<div class="col-md-6">
					<div class="row mb-5">
						<div class="col-md-6 mb-3 mb-md-0">
							<button class="btn btn-black btn-sm btn-block">Update Cart</button>
						</div>
						<div class="col-md-6">
							<button class="btn btn-outline-black btn-sm btn-block" asp-controller="Product"
								asp-action="ProductIndex">Continue Shopping</button>
						</div>
					</div>
					<div class="row">
						<div class="col-md-12">
							<label class="text-black h4" for="coupon">Coupon</label>
							<p>Enter your coupon code if you have one.</p>
						</div>
						<div class="col-md-8 mb-3 mb-md-0">
							<input type="text" class="form-control py-3" id="coupon" placeholder="Coupon Code">
						</div>
						<div class="col-md-4">
							<button class="btn btn-black">Apply Coupon</button>
						</div>
					</div>
				</div>
				<div class="col-md-6 pl-5">
					<div class="row justify-content-end">
						<div class="col-md-7">
							<div class="row">
								<div class="col-md-12 text-right border-bottom mb-5">
									<h3 class="text-black h4 text-uppercase">Cart Totals</h3>
								</div>
							</div>
							<div class="row mb-3">
								<div class="col-md-6">
									<span class="text-black">Subtotal</span>
								</div>
								<div class="col-md-6 text-right">
									<strong class="text-black">$230.00</strong>
								</div>
							</div>
							<div class="row mb-5">
								<div class="col-md-6">
									<span class="text-black">Total</span>
								</div>
								<div class="col-md-6 text-right">
									<strong class="text-black">$230.00</strong>
								</div>
							</div>

							<div class="row">
								<form action="/order/checkout" method="get">
									<div class="col-md-12">
										<button type="submit" class="btn btn-black btn-lg py-3 btn-block">Proceed To
											Checkout</button>
									</div>
								</form>
							</div>


						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script src="~/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/tiny-slider.js"></script>
	<script src="~/js/custom.js"></script>
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
	<script>

		function updateCartItemQuantity(cartItemId, quantity) {
			$.ajax({
				url: "/Cart/UpdateCartItemByQuantity",
				type: "PATCH",
				contentType: "application/json",
				data: JSON.stringify({ cartItemId: cartItemId, quantity: quantity }),
				success: function (response) {
					console.log("Cập nhật thành công!");
					updateProductTotalPrice();
				},
				error: function (xhr, status, error) {
					console.error("Lỗi cập nhật:", xhr.responseText);
				}
			});
		}

		// Bắt sự kiện khi thay đổi số lượng
		$(document).on("change", ".quantity", function () {
			let cartItemId = $(this).data("cartitem-id");
			let quantity = $(this).val();
			updateCartItemQuantity(cartItemId, quantity);
		});

		function updateProductTotalPrice(cartItemId) {
			let input = document.querySelector(`[data-cartItem-id="${cartItemId}"]`);
			let quantity = parseInt(input.value) || 0;
			let price = parseFloat(input.closest("tr").querySelector(".price").dataset.price);

			// Tính tổng tiền của sản phẩm đó
			let totalPrice = quantity * price;

			// Cập nhật tổng tiền cho đúng sản phẩm
			document.getElementById(`productTotalPrice-${cartItemId}`).innerText = totalPrice.toLocaleString("vi-VN");
		}
		$(document).on("change", ".quantity", function () {
			let cartItemId = $(this).data("cartitem-id");
			let quantity = parseInt($(this).val()) || 0;
			let price = parseFloat($(this).closest("tr").find(".price").data("price"));

			// Tính tổng tiền
			let totalPrice = quantity * price;

			// Cập nhật UI
			$(`#productTotalPrice-${cartItemId}`).text(totalPrice.toLocaleString("vi-VN") + " $");
		});

		$(document).on("change", ".cart-item-checkbox", function () {
			event.preventDefault();

			let cartItemId = $(this).data("cartitem-id");
			let isChecked = $(this).prop("checked"); // Lấy trạng thái checked

			console.log("CartItemId:", cartItemId, "Checked:", isChecked);

			updateCartItemStatus(cartItemId, isChecked);
		});

		function updateCartItemStatus(cartItemId, isChecked) {
			$.ajax({
				url: `/Cart/UpdateCartItemByStatus/${cartItemId}`,
				type: "PATCH",
				contentType: "application/json",
				data: JSON.stringify({ status: isChecked }), // Gửi trạng thái checked
				success: function (response) {
					console.log("Response:", response);

				},
				error: function (xhr, status, error) {
					console.error("Lỗi:", xhr.responseText);
					alert("Đã xảy ra lỗi, vui lòng thử lại!");
				}
			});
		}

		function deleteCartItem(cartItemId) {
			$.ajax({
				url: `/Cart/DeleteCartItem/${cartItemId}`, // Sử dụng template string
				type: "DELETE",
				success: function (response) {
					console.log("Xóa thành công!");
					$("#cart-item-" + cartItemId).fadeOut(500, function () {
						$(this).remove();
					});
				},
				error: function (xhr, status, error) {
					console.error("Lỗi xóa sản phẩm:", xhr.responseText);
				}
			});

		}

		// Bắt sự kiện khi bấm nút xóa
		$(document).on("click", ".btn-delete-cart-item", function (event) {
			event.preventDefault();
			let cartItemId = $(this).data("cartitem-id");
			deleteCartItem(cartItemId);
		});


				document.addEventListener("DOMContentLoaded", function () {
			let inputs = document.querySelectorAll("input[type='number'].quantity");

			inputs.forEach(input => {
				input.addEventListener("input", function () {
					let max = parseInt(input.max);
					let min = parseInt(input.min);
					let value = parseInt(input.value);

					if (value > max) {
						input.value = max; // Giới hạn về max
						alert("Stock quantity of product is" +max);
					} else if (value < min) {
						input.value = min; // Giới hạn về min
					}
				});
			});
		});
	</script>
</body>

</html>